# DNS resolver for OCSP stapling and any runtime upstream DNS lookups.
# IPv6 disabled - nginx hangs on AAAA lookups when IPv6 isn't routable.
resolver 1.1.1.1 8.8.8.8 valid=300s ipv6={{ 'on' if resolver_ipv6 else 'off' }};
resolver_timeout 5s;

{% if ips_blacklist %}
######################################################
## Block spammers and other unwanted visitors by IP ##
######################################################
{% for ip in ips_blacklist %}
deny {{ ip }};
{% endfor %}
{% endif %}

{% if geoip_blocking_enabled %}
###################################################################
## Block spammers and other unwanter visitors by geolocation     ##
## Reference: https://github.com/leev/ngx_http_geoip2_module     ##
###################################################################
## Extra: https://stackoverflow.com/questions/64071451

geoip2 {{ geoip_database_directory }}/GeoLite2-Country/GeoLite2-Country.mmdb {
    auto_reload 5m;
    $geoip2_metadata_country_build metadata build_epoch;

    $geoip2_data_country_code country iso_code;
    $geoip2_data_country_name country names en;
    $geoip2_data_continent_code continent code;
}

geoip2 {{ geoip_database_directory }}/GeoLite2-City/GeoLite2-City.mmdb {
    $geoip2_data_city_name city names en;
}

# Private addresses: the LAN and the Docker networks. They have no country.
geo $geoip_private_client {
    default        "";
    127.0.0.0/8    private;
    10.0.0.0/8     private;
    172.16.0.0/12  private;
    192.168.0.0/16 private;
    ::1            private;
    fc00::/7       private;
}

# Keyed "<private>:<continent>:<country>". Regexes match in order: private clients pass, then
# blacklisted countries are blocked before the allowed countries and continents.
map "$geoip_private_client:$geoip2_data_continent_code:$geoip2_data_country_code" $allow_visit {
    default {{ geoip_blocking_default }};
    "~^private:" allow;
    {%- for country in geoip_countries_blacklist %}
    "~:{{ country }}$" block;
    {%- endfor %}
    {%- for country in geoip_countries_whitelist %}
    "~:{{ country }}$" allow;
    {%- endfor %}
    {%- for continent in geoip_continents_whitelist %}
    "~^:{{ continent }}:" allow;
    {%- endfor %}
}
{% endif %}
